; Engine configuration file.
; Underground Roguelite – Solo-Prototyp

config_version=5

[application]

config/name="Underground Roguelite"
config/description="Low-Poly Action-Roguelite – Prototyp mit 3 Testräumen"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="enemies"
3d_physics/layer_4="player_hurtbox"
3d_physics/layer_5="enemy_hurtbox"
3d_physics/layer_6="triggers"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
3d/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.07, 0.11, 0.12, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
